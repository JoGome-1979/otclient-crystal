# Called by the Windows build; never configures or compiles the client.
cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS SOURCE_ROOT BINARY_ROOT BINARY_FILE BINARY_ARCH BUILD_CONFIG PRESET)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
if(NOT PRESET MATCHES "^[A-Za-z0-9_-]+$" OR NOT BINARY_ARCH MATCHES "^(x86|x64)$")
  message(FATAL_ERROR "Invalid preset or architecture")
endif()
get_filename_component(SOURCE_ROOT "${SOURCE_ROOT}" ABSOLUTE)
get_filename_component(BINARY_ROOT "${BINARY_ROOT}" ABSOLUTE)
get_filename_component(BINARY_FILE "${BINARY_FILE}" ABSOLUTE)
set(EXPECTED_BINARY "${BINARY_ROOT}/bin/Cliente${BINARY_ARCH}.exe")
if(NOT BINARY_FILE STREQUAL EXPECTED_BINARY)
  message(FATAL_ERROR "Unexpected linker output: ${BINARY_FILE}")
endif()
set(PLATFORM windows)
# Debug and sanitizer builds may need vcpkg's app-local DLLs; symbols stay in build/.
set(ALLOW_DYNAMIC_LIBRARIES FALSE)
if(BUILD_CONFIG STREQUAL "Debug" OR PRESET MATCHES "asan")
  set(ALLOW_DYNAMIC_LIBRARIES TRUE)
endif()
set(OUTPUT_ROOT "${BINARY_ROOT}/distribution-stage/CrystalClient")
include("${SOURCE_ROOT}/cmake/StageClientBootstrap.cmake")
set(DESTINATION "${SOURCE_ROOT}/dist/${PRESET}")
# Replace only managed distribution folders. Unknown files remain recoverable.
if(EXISTS "${DESTINATION}" AND NOT EXISTS "${DESTINATION}/.crystal-distribution")
  string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
  string(RANDOM LENGTH 8 suffix)
  file(MAKE_DIRECTORY "${BINARY_ROOT}/distribution-backups")
  file(RENAME "${DESTINATION}" "${BINARY_ROOT}/distribution-backups/${stamp}-${suffix}")
else()
  file(REMOVE_RECURSE "${DESTINATION}")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY "${OUTPUT_ROOT}/" DESTINATION "${DESTINATION}"
  PATTERN ".crystal-installer-stage" EXCLUDE)
file(WRITE "${DESTINATION}/.crystal-distribution" "Generated first-run distribution for ${PRESET}.\n")
message(STATUS "Minimal Windows distribution: ${DESTINATION}")
