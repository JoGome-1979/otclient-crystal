cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS SOURCE_ROOT BINARY_ROOT BINARY_FILE BUILD_CONFIG PRESET)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
if(NOT PRESET MATCHES "^[A-Za-z0-9_-]+$")
  message(FATAL_ERROR "Invalid Linux distribution preset")
endif()
get_filename_component(SOURCE_ROOT "${SOURCE_ROOT}" ABSOLUTE)
get_filename_component(BINARY_ROOT "${BINARY_ROOT}" ABSOLUTE)
get_filename_component(BINARY_FILE "${BINARY_FILE}" ABSOLUTE)
if(NOT BINARY_FILE STREQUAL "${BINARY_ROOT}/bin/Crystal")
  message(FATAL_ERROR "Unexpected Linux linker output: ${BINARY_FILE}")
endif()
set(PLATFORM linux)
set(OUTPUT_ROOT "${BINARY_ROOT}/distribution-stage/CrystalClient")
include("${SOURCE_ROOT}/cmake/StageClientBootstrap.cmake")
# Strip only the distributable copy. The original retains debugging information.
find_program(LINUX_STRIP NAMES strip REQUIRED)
execute_process(COMMAND "${LINUX_STRIP}" --strip-debug "${OUTPUT_ROOT}/Crystal"
  COMMAND_ERROR_IS_FATAL ANY)
file(CHMOD "${OUTPUT_ROOT}/Crystal" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
  GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(DESTINATION "${SOURCE_ROOT}/dist/${PRESET}")
if(EXISTS "${DESTINATION}" AND NOT EXISTS "${DESTINATION}/.crystal-distribution")
  string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
  string(RANDOM LENGTH 8 suffix)
  file(MAKE_DIRECTORY "${BINARY_ROOT}/distribution-backups")
  file(RENAME "${DESTINATION}" "${BINARY_ROOT}/distribution-backups/${stamp}-${suffix}")
else()
  file(REMOVE_RECURSE "${DESTINATION}")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY "${OUTPUT_ROOT}/" DESTINATION "${DESTINATION}"
  PATTERN ".crystal-installer-stage" EXCLUDE)
file(WRITE "${DESTINATION}/.crystal-distribution" "Generated Linux first-run distribution for ${PRESET}.\n")
message(STATUS "Minimal Linux distribution: ${DESTINATION}")
