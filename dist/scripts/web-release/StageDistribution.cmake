cmake_minimum_required(VERSION 3.24)
if(NOT PRESET MATCHES "^web-(release|debug)$")
  message(FATAL_ERROR "Unsupported web preset: ${PRESET}")
endif()
file(REAL_PATH "${SOURCE_ROOT}" SOURCE_ROOT)
file(REAL_PATH "${BINARY_ROOT}" BINARY_ROOT)
if(NOT BINARY_ROOT STREQUAL "${SOURCE_ROOT}/build/${PRESET}")
  message(FATAL_ERROR "Web staging must use build/${PRESET}")
endif()
set(output "${SOURCE_ROOT}/dist/${PRESET}")
foreach(required IN ITEMS index.html index.js index.wasm index.data)
  if(NOT EXISTS "${BINARY_ROOT}/bin/${required}")
    message(FATAL_ERROR "Incomplete web build: ${required} missing")
  endif()
endforeach()
file(MAKE_DIRECTORY "${output}")
file(GLOB artifacts "${BINARY_ROOT}/bin/*.html" "${BINARY_ROOT}/bin/*.js" "${BINARY_ROOT}/bin/*.wasm" "${BINARY_ROOT}/bin/*.data")
# Refresh generated artifacts only; symbols and dependency caches stay in build/.
file(GLOB previous "${output}/*.html" "${output}/*.js" "${output}/*.wasm" "${output}/*.data")
foreach(old IN LISTS previous)
  file(REMOVE "${old}")
endforeach()
foreach(artifact IN LISTS artifacts)
  file(COPY "${artifact}" DESTINATION "${output}")
endforeach()
file(WRITE "${output}/.crystal-distribution" "${PRESET}\n")
message(STATUS "Web distribution: ${output}")
